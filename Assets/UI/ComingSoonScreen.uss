.coming-soon-screen {
    flex-grow: 1;
    background-color: rgb(244, 246, 252);
}

.coming-soon-top-bar {
    height: 76px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 20px;
    padding-right: 20px;
    background-color: rgb(249, 250, 253);
    border-bottom-width: 1px;
    border-bottom-color: rgb(230, 235, 244);
}

.coming-soon-back {
    width: 34px;
    height: 34px;
    background-color: transparent;
    border-width: 0;
    color: rgb(7, 25, 56);
    font-size: 22px;
    -unity-font-style: bold;
    margin-right: 8px;
}

.coming-soon-brand {
    color: rgb(7, 25, 56);
    font-size: 16px;
    -unity-font-style: bold;
}

.coming-soon-scroll {
    flex-grow: 1;
    width: 100%;
}

.coming-soon-content {
    flex-grow: 1;
    width: 100%;
    padding: 24px;
    align-items: center;
}

.coming-soon-icon-circle {
    width: 140px;
    height: 140px;
    border-radius: 70px;
    background-color: rgb(216, 227, 248);
    justify-content: center;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 20px;
}

.coming-soon-icon-core {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background-color: transparent;
    background-image: url("Icons/mdi--hourglass.svg");
    -unity-background-image-tint-color: rgb(20, 103, 223);
    -unity-background-scale-mode: scale-to-fit;
    background-repeat: no-repeat;
}

.coming-soon-title {
    width: 100%;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(5, 31, 74);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 12px;
    padding-left: 24px;
    padding-right: 24px;
}

.coming-soon-desc {
    width: 100%;
    font-size: 14px;
    color: rgb(50, 61, 80);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 18px;
    padding-left: 20px;
    padding-right: 20px;
}

.coming-soon-card {
    width: 100%;
    border-radius: 16px;
    background-color: rgb(206, 218, 240);
    padding: 18px;
    margin-bottom: 24px;
}

.coming-soon-card-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(6, 28, 67);
    margin-bottom: 8px;
}

.coming-soon-card-body {
    font-size: 13px;
    color: rgb(39, 52, 75);
    white-space: normal;
}

.coming-soon-return {
    width: 100%;
    height: 58px;
    border-radius: 30px;
    border-width: 0;
    background-color: rgb(20, 111, 226);
    color: white;
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 14px;
}
